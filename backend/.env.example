# Google Sheets Configuration
SPREADSHEET_ID=16Kya2WQD0tbXTdsug9zSuoP03XmWXsZRTIykbEbBJBU
SHEET_NAME=COA

# Google Service Account Credentials (JSON string)
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# Polygon Configuration
# For Amoy Testnet:
POLYGON_RPC=https://rpc-amoy.polygon.technology
# For Mainnet:
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com

# Smart Contract Address (fill after deployment)
CONTRACT_ADDRESS=

# Optional: enables POST /api/create with mintPolygon=true.
# Keep this server-side only. Never expose it to frontend code.
PRIVATE_KEY=

# Metadata URL used as the tokenURI when minting Polygon COA NFTs.
# This must return marketplace metadata whose image is the rendered COA.
METADATA_BASE_URL=https://coa.up.railway.app/api/nft
PUBLIC_API_BASE_URL=https://coa.up.railway.app
PUBLIC_FRONTEND_URL=https://truecoa.com

# Optional: enables POST /api/create with createScoreDetect=true.
# Use the zpka_ key from ScoreDetect Settings > API Key. Keep it server-side only.
SCOREDETECT_API_KEY=
SCOREDETECT_API_URL=https://api.scoredetect.com
SCOREDETECT_VERIFICATION_BASE_URL=https://explorer.scoredetect.com/certificate

# Server Port
PORT=3001
